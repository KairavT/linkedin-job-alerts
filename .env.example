# Copy to .env and fill in at least one channel. .env is gitignored.

# --- Email (Gmail shown; any SMTP server works) ---
# Gmail needs an app password, not your normal one: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=                 # defaults to SMTP_USER; comma-separate for several recipients

# --- Phone push via ntfy (free, no account) ---
# Install the ntfy app (iOS/Android), subscribe to a topic, and put the same name here.
# Anyone who knows the topic name can read it, so make it hard to guess.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
